# Copie para .env na raiz para desenvolvimento local (sobrescreve defaults do compose).
# Gere uma chave com: docker compose run --rm api php artisan key:generate --show
APP_KEY=

# Banco (dev defaults: memora/memora/memora — sobrescreva em produção).
POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora

# URL pública da API usada pelo build do frontend (vazio = usa /api via nginx).
VITE_API_URL=

# Permite seed via API em dev (nunca true em produção).
ALLOW_SEED=false
